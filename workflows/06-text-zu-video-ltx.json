{
  "_zweck": "Text -> kinoreifer bewegter Clip. LTX-Video 2B (Text-to-Video). Liefert atmosphaerische, fotorealistische Szenen (Hintergruende, Establishing-Shots).",
  "_prompt_setzen": "Node 2, inputs.text. Aufloesung/Laenge in Node 4 (length = Frames, ~57-73 fuer 2-3 s).",
  "_wichtig": "Separater T5-Encoder (Node 13, type 'ltxv') noetig. LTX laeuft auf Apple MPS -- Wan 2.2 dagegen NICHT (siehe analysis/007).",
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "ltx-video-2b-v0.9.5.safetensors"}},
  "13": {"class_type": "CLIPLoader", "inputs": {"clip_name": "t5xxl_fp8_e4m3fn.safetensors", "type": "ltxv", "device": "default"}},
  "2": {"class_type": "CLIPTextEncode", "inputs": {"text": "a breathtaking cosmic nebula, glowing stars, slow drift, ultra detailed, cinematic, IMAX", "clip": ["13", 0]}},
  "3": {"class_type": "CLIPTextEncode", "inputs": {"text": "blurry, low quality, distorted, watermark, text, deformed", "clip": ["13", 0]}},
  "4": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": 704, "height": 480, "length": 57, "batch_size": 1}},
  "5": {"class_type": "LTXVConditioning", "inputs": {"positive": ["2", 0], "negative": ["3", 0], "frame_rate": 25.0}},
  "6": {"class_type": "ModelSamplingLTXV", "inputs": {"model": ["1", 0], "max_shift": 2.05, "base_shift": 0.95, "latent": ["4", 0]}},
  "7": {"class_type": "LTXVScheduler", "inputs": {"steps": 30, "max_shift": 2.05, "base_shift": 0.95, "stretch": true, "terminal": 0.1, "latent": ["4", 0]}},
  "8": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
  "9": {"class_type": "SamplerCustom", "inputs": {"model": ["6", 0], "add_noise": true, "noise_seed": 42, "cfg": 3.0, "positive": ["5", 0], "negative": ["5", 1], "sampler": ["8", 0], "sigmas": ["7", 0], "latent_image": ["4", 0]}},
  "10": {"class_type": "VAEDecode", "inputs": {"samples": ["9", 0], "vae": ["1", 2]}},
  "11": {"class_type": "CreateVideo", "inputs": {"images": ["10", 0], "fps": 25.0}},
  "12": {"class_type": "SaveVideo", "inputs": {"video": ["11", 0], "filename_prefix": "ltx-t2v/clip", "format": "mp4", "codec": "h264"}}
}
