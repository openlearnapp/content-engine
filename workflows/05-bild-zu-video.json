{
  "_zweck": "Standbild -> bewegter Clip. LTX-Video 2B (Image-to-Video). Animiert ein vorhandenes Standbild mit sanfter Bewegung.",
  "_prompt_setzen": "Node 2, inputs.text (beschreibt die gewuenschte Bewegung). Startbild: Node 14, inputs.image (Datei in ComfyUI/input/).",
  "_wichtig": "LTX braucht einen separaten T5-Encoder (Node 13, type 'ltxv') -- der Checkpoint enthaelt keinen. Sampler ueber LTXVScheduler+SamplerCustom, nicht KSampler.",
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "ltx-video-2b-v0.9.5.safetensors"}},
  "13": {"class_type": "CLIPLoader", "inputs": {"clip_name": "t5xxl_fp8_e4m3fn.safetensors", "type": "ltxv", "device": "default"}},
  "2": {"class_type": "CLIPTextEncode", "inputs": {"text": "gentle camera motion, subtle movement, cinematic", "clip": ["13", 0]}},
  "3": {"class_type": "CLIPTextEncode", "inputs": {"text": "blurry, low quality, distorted, watermark, text, deformed, flickering", "clip": ["13", 0]}},
  "14": {"class_type": "LoadImage", "inputs": {"image": "start.png"}},
  "15": {"class_type": "LTXVImgToVideo", "inputs": {"positive": ["2", 0], "negative": ["3", 0], "vae": ["1", 2], "image": ["14", 0], "width": 768, "height": 768, "length": 73, "batch_size": 1, "strength": 1.0}},
  "5": {"class_type": "LTXVConditioning", "inputs": {"positive": ["15", 0], "negative": ["15", 1], "frame_rate": 25.0}},
  "6": {"class_type": "ModelSamplingLTXV", "inputs": {"model": ["1", 0], "max_shift": 2.05, "base_shift": 0.95, "latent": ["15", 2]}},
  "7": {"class_type": "LTXVScheduler", "inputs": {"steps": 30, "max_shift": 2.05, "base_shift": 0.95, "stretch": true, "terminal": 0.1, "latent": ["15", 2]}},
  "8": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
  "9": {"class_type": "SamplerCustom", "inputs": {"model": ["6", 0], "add_noise": true, "noise_seed": 42, "cfg": 3.0, "positive": ["5", 0], "negative": ["5", 1], "sampler": ["8", 0], "sigmas": ["7", 0], "latent_image": ["15", 2]}},
  "10": {"class_type": "VAEDecode", "inputs": {"samples": ["9", 0], "vae": ["1", 2]}},
  "11": {"class_type": "CreateVideo", "inputs": {"images": ["10", 0], "fps": 25.0}},
  "12": {"class_type": "SaveVideo", "inputs": {"video": ["11", 0], "filename_prefix": "ltx-i2v/clip", "format": "mp4", "codec": "h264"}}
}
